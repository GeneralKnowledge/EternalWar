; Engine configuration file.
; Godot 4.3 — Limit Theory–inspired procedural space simulation

config_version=5

[application]

config/name="Limit Theory Prototype"
config/description="Procedural systemic space simulation inspired by Limit Theory."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]

gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/inferred_declaration=1
gdscript/warnings/untyped_declaration=0

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

