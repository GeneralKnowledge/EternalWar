# Copy to .env and adjust. server.py loads .env automatically.

# Path to built Josh ltheory checkout (must contain tools/wallpaper.sh)
LTHEORY_ROOT=/opt/lt-wallpaper/ltheory

# Bind
LT_GALLERY_HOST=127.0.0.1
LT_GALLERY_PORT=8787

# Persistent gallery storage (manifest + PNGs)
LT_GALLERY_DATA=/var/lib/lt-wallpaper/gallery

# small | standard | full — or omit to auto-detect from MemTotal
LT_GALLERY_PROFILE=small

# One bake per IP
LT_GALLERY_RATE_SEC=60

# Bake subprocess timeout
LT_GALLERY_BAKE_TIMEOUT=600
