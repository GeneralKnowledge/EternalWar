[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libew_kernels.so"
linux.release.x86_64 = "res://bin/libew_kernels.so"
windows.debug.x86_64 = "res://bin/ew_kernels.dll"
windows.release.x86_64 = "res://bin/ew_kernels.dll"
macos.debug = "res://bin/libew_kernels.dylib"
macos.release = "res://bin/libew_kernels.dylib"
macos.debug.arm64 = "res://bin/libew_kernels.dylib"
macos.release.arm64 = "res://bin/libew_kernels.dylib"
